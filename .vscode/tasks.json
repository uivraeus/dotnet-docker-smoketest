{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/DotnetDockerSmoketest.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "coverage report",
      "type": "shell",
      "command": "rm -rf TestResults coverage-report && dotnet tool restore && dotnet test --coverage --coverage-output-format cobertura && dotnet reportgenerator -reports:'TestResults/**/*.cobertura.xml' -targetdir:coverage-report -reporttypes:'TextSummary;Html' -filefilters:'-*/obj/*' && cat coverage-report/Summary.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "--project", "${workspaceFolder}/src/DotnetDockerSmoketest.Api"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
