{
  "version": "0.2.0",
  "configurations": [
    {
      // Requires the C# extension (ms-dotnettools.csharp)
      "name": "DotnetDockerSmoketest.Api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/DotnetDockerSmoketest.Api/bin/Debug/net10.0/DotnetDockerSmoketest.Api.dll",
      "cwd": "${workspaceFolder}/src/DotnetDockerSmoketest.Api",
      "launchSettingsProfile": "http",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      // Debug tests: runs the test executable with xUnit's own console runner (see README.md, "Test platform")
      "name": "Tests (xUnit runner)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/DotnetDockerSmoketest.Api.Tests/bin/Debug/net10.0/DotnetDockerSmoketest.Api.Tests.dll",
      "args": ["-method", "${input:testMethodFilter}"],
      "cwd": "${workspaceFolder}/tests/DotnetDockerSmoketest.Api.Tests/bin/Debug/net10.0",
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to process",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "inputs": [
    {
      "id": "testMethodFilter",
      "type": "promptString",
      "description": "Test method filter (fully qualified name, * wildcards allowed)",
      "default": "*"
    }
  ]
}
