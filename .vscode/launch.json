{
  "version": "0.2.0",
  "configurations": [
    {
      // Requires the C# extension (ms-dotnettools.csharp) or C# Dev Kit
      "name": "DotnetDockerSmoketest.Api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/DotnetDockerSmoketest.Api/bin/Debug/net10.0/DotnetDockerSmoketest.Api.dll",
      "cwd": "${workspaceFolder}/src/DotnetDockerSmoketest.Api",
      "launchSettingsProfile": "http",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach to process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
