<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test platform: xUnit v3 (4.x) on Microsoft.Testing.Platform (MTP) v2. See "Test platform" in README.md.

    This project intentionally differs from `dotnet new xunit`, which still generates xUnit v2 on VSTest:
      - OutputType=Exe: the test project is a self-contained test runner executable. With the
        argument server (as used by dotnet test) it runs on MTP;
        started directly or via dotnet run, it uses xUnit's own console runner instead.
      - No Microsoft.NET.Test.Sdk, xunit.runner.visualstudio or coverlet.collector: these are
        VSTest-only. Adding them back does not help; `dotnet test` needs the MTP opt-in in global.json.
      - Coverage comes from Microsoft.Testing.Extensions.CodeCoverage (see README.md for usage).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Underscore-separated test names are idiomatic -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetDockerSmoketest.Api\DotnetDockerSmoketest.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
